# Copy to .env for local development. Never commit .env.
#   cp .env.example .env

# SQLite (local). Docker uses file:/data/dev.db via compose.
DATABASE_URL="file:./prisma/dev.db"

# Required in production. Local dev has an insecure in-code fallback if unset.
# Generate: openssl rand -hex 32
# ALTCHA_HMAC_KEY=

# Optional. When true, skip ALTCHA for crew/test OTP phones (+15551001xxx).
# ALTCHA_BYPASS_TEST_PHONES=false

# Optional Twilio Verify. Unset = mock SMS (OTP shown in the login UI / API).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Extra mock-OTP phones (comma-separated E.164), in addition to +15551001xxx.
# TEST_OTP_PHONES=

# Docker only: true wipes and reseeds demo data. Production overlay defaults to false.
# DEMO_SEED=false

# Fallback area when the visitor IP is private/unresolvable.
# DEV_GEO_ZIP=28301
# DEV_GEO_LAT=35.0527
# DEV_GEO_LNG=-78.8784
# DEV_GEO_LABEL=Fayetteville, NC

# Optional moderator allowlist (user ids or slugs), comma-separated.
# MODERATOR_USER_IDS=

# Optional upload directory. Default: ./data/uploads (or /data/uploads in Docker).
# UPLOAD_ROOT=
