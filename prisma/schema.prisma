generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VerificationTier {
  UNVERIFIED
  VERIFIED_HOST
}

enum GroupType {
  COMMUNITY
  ORGANIZATION
  BUSINESS
}

enum GroupVerification {
  UNVERIFIED
  ESTABLISHED
}

enum ListingType {
  ONE_TIME_EVENT
  RECURRING_EVENT
  GROUP_SEEKING
  HANGOUT_SPOT
  VOLUNTEER
  WORKSHOP
  LOOKING_FOR
}

enum PosterType {
  PERSON
  GROUP
  ORGANIZATION
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  NEIGHBORHOOD
}

enum ListingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ListingNatureTag {
  INDIVIDUAL
  GATHERING
  BUSINESS
  ORGANIZATION
  LARGE_EVENT
}

enum RsvpStatus {
  INTERESTED
  GOING
  WAITLIST
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model User {
  id                  String           @id @default(cuid())
  phone               String           @unique
  phoneVerifiedAt     DateTime?
  email               String?          @unique
  emailVerifiedAt     DateTime?
  name                String
  slug                String           @unique
  headline            String?
  bio                 String?
  avatarUrl           String?
  verificationTier    VerificationTier @default(UNVERIFIED)
  isModerator         Boolean          @default(false)
  reputationScore     Int              @default(0)
  reputationUpdatedAt DateTime?
  zipCode             String?
  latitude            Float?
  longitude           Float?
  locationLabel       String?
  radiusMiles         Int              @default(20)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  interests            UserInterest[]
  groupsCreated        Group[]             @relation("GroupCreator")
  groupMembers         GroupMember[]
  listings             Listing[]           @relation("UserListings")
  rsvps                Rsvp[]
  alerts               Alert[]
  messages             Message[]
  reportsMade          Report[]            @relation("ReportsMade")
  reportsReviewed      Report[]            @relation("ReportsReviewed")
  announcements        Announcement[]
  skillOffers          SkillOffer[]
  reputationEvents     ReputationEvent[]   @relation("ReputationSubject")
  reputationActions    ReputationEvent[]   @relation("ReputationActor")
  feedbackGiven        Feedback[]          @relation("FeedbackFrom")
  feedbackReceived     Feedback[]          @relation("FeedbackTo")
  suggestions          Suggestion[]
  suggestionVotes      SuggestionVote[]
}

model Interest {
  id   String @id @default(cuid())
  slug String @unique
  name String
  icon String?

  users       UserInterest[]
  listings    ListingInterest[]
  alerts      Alert[]
  skillOffers SkillOfferInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Group {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String
  coverImageUrl    String?
  type             GroupType         @default(COMMUNITY)
  verification     GroupVerification @default(UNVERIFIED)
  latitude         Float?
  longitude        Float?
  locationLabel    String?
  foundedAt        DateTime          @default(now())
  createdById      String
  createdBy        User              @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members  GroupMember[]
  listings Listing[]   @relation("GroupListings")
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Listing {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  title                 String
  description           String
  type                  ListingType
  posterType            PosterType
  posterUserId          String?
  posterGroupId         String?
  latitude              Float
  longitude             Float
  locationLabel         String
  locationPrecision     LocationPrecision @default(APPROXIMATE)
  startsAt              DateTime?
  endsAt                DateTime?
  recurrenceRule        String?
  capacity              Int?
  rsvpRequired          Boolean           @default(false)
  rsvpApprovalRequired  Boolean           @default(false)
  homeHosted            Boolean           @default(false)
  isPaid                Boolean           @default(false)
  priceMin              Float?
  priceMax              Float?
  natureTag             ListingNatureTag  @default(GATHERING)
  status                ListingStatus     @default(ACTIVE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  posterUser  User?             @relation("UserListings", fields: [posterUserId], references: [id])
  posterGroup Group?            @relation("GroupListings", fields: [posterGroupId], references: [id])
  interests         ListingInterest[]
  rsvps             Rsvp[]
  messages          Message[]
  reports           Report[]
  announcements     Announcement[]
  reputationEvents  ReputationEvent[]
  feedback          Feedback[]
}

model Message {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  body      String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  listingId      String
  reporterId     String
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  reviewedAt     DateTime?
  reviewerId     String?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter       User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer       User?        @relation("ReportsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)
}

model Announcement {
  id        String   @id @default(cuid())
  listingId String
  hostId    String
  body      String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model ListingInterest {
  listingId  String
  interestId String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([listingId, interestId])
}

model Rsvp {
  id        String     @id @default(cuid())
  listingId String
  userId    String
  status    RsvpStatus @default(INTERESTED)
  approved  Boolean    @default(true)
  message   String?
  createdAt DateTime   @default(now())
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  interestId  String
  radiusMiles Int      @default(20)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest    Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

model PhoneOtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum SkillOfferStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReputationReason {
  EVENT_HOSTED
  EVENT_COMPLETED
  POSITIVE_FEEDBACK
  NEGATIVE_FEEDBACK
  VOUCH
  REPORT_UPHELD
  SKILL_COMPLETED
  PROFILE_COMPLETED
}

model SkillOffer {
  id            String           @id @default(cuid())
  slug          String           @unique
  userId        String
  title         String
  description   String
  status        SkillOfferStatus @default(ACTIVE)
  latitude      Float?
  longitude     Float?
  locationLabel String?
  radiusMiles   Int?
  priceMin      Float?
  priceMax      Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests        SkillOfferInterest[]
  reputationEvents ReputationEvent[]
  feedback         Feedback[]
}

model SkillOfferInterest {
  skillOfferId String
  interestId   String
  skillOffer   SkillOffer @relation(fields: [skillOfferId], references: [id], onDelete: Cascade)
  interest     Interest   @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([skillOfferId, interestId])
}

model ReputationEvent {
  id            String           @id @default(cuid())
  subjectUserId String
  actorUserId   String?
  listingId     String?
  skillOfferId  String?
  reason        ReputationReason
  points        Int
  note          String?
  createdAt     DateTime         @default(now())

  subject    User        @relation("ReputationSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ReputationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  skillOffer SkillOffer? @relation(fields: [skillOfferId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt])
}

model Feedback {
  id           String   @id @default(cuid())
  fromUserId   String
  toUserId     String
  listingId    String?
  skillOfferId String?
  rating       Int
  body         String?
  createdAt    DateTime @default(now())

  fromUser   User        @relation("FeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User        @relation("FeedbackTo", fields: [toUserId], references: [id], onDelete: Cascade)
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  skillOffer SkillOffer? @relation(fields: [skillOfferId], references: [id], onDelete: SetNull)

  @@unique([fromUserId, toUserId, listingId])
  @@unique([fromUserId, toUserId, skillOfferId])
  @@index([toUserId, createdAt])
}

enum SuggestionStatus {
  OPEN
  PLANNED
  DONE
  CLOSED
}

model Suggestion {
  id        String           @id @default(cuid())
  slug      String?          @unique
  title     String
  body      String
  authorId  String
  status    SuggestionStatus @default(OPEN)
  voteCount Int              @default(0)
  createdAt DateTime         @default(now())

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  SuggestionVote[]

  @@index([status, createdAt])
  @@index([status, voteCount])
}

model SuggestionVote {
  id           String   @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([userId])
}
